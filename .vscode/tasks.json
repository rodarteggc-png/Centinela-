{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Desplegar Cambios a Servidor (Z:)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/deploy-to-server.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🔌 Conectar Unidad Z: (SSHFS Rocky Linux)",
      "type": "shell",
      "command": "net use Z: \\\\sshfs.r\\pggr@192.168.220.20 /persistent:yes",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "📋 Sincronizar Inventario de Bases de Datos (databases_fleet.csv)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/sync-fleet-inventory.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}

