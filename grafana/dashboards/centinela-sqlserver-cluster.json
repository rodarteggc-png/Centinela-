    {
      "id": 1,
      "gridPos": {
        "h": 11,
        "w": 17,
        "x": 0,
        "y": 5
      },
      "type": "timeseries",
      "title": "Workload - Active Session Sampling (AAS)",
      "description": "AAS is the average count of active sessions per successful sample. Successful empty samples count as zero; failed samples are excluded. The red series is SQL Server schedulers available for user workload.",
      "datasource": {
        "type": "prometheus",
        "uid": "centinela-prometheus"
      },
      "targets": [
        {
          "expr": "centinela_aas_total{cluster=~\"$cluster\", target=~\"$target\"}",
          "legendFormat": "{{category}}",
          "refId": "AAS"
        },
        {
          "expr": "centinela_sql_visible_schedulers{cluster=~\"$cluster\", target=~\"$target\"}",
          "legendFormat": "SQL Schedulers",
          "refId": "CORES"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 60,
            "gradientMode": "opacity",
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "color",
                "value": {
