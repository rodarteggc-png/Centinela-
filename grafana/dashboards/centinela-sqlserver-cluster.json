    {
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 12,
        "y": 35
      },
      "type": "timeseries",
      "title": "Engine Throughput: Batch Requests & Compilations / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "centinela-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(sqlserver_batch_requests_total{cluster=~\"$cluster\"}[1m]))",
          "legendFormat": "Batch Requests / sec",
          "refId": "BATCH"
        },
        {
          "expr": "sum(rate(sqlserver_sql_compilations_total{cluster=~\"$cluster\"}[1m]))",
          "legendFormat": "SQL Compilations / sec",
          "refId": "COMP"
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "reqps"
